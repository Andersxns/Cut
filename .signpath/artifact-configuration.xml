<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the Windows installer: the "cut-browser-Windows" artifact of
  the Build workflow (.github/workflows/build.yml). Set it as the project's default artifact
  configuration in SignPath. The workflow passes the version from the release tag, and only an
  installer whose version info says Cut Browser and that version is signed.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Cut-Browser-*-Setup-x64.exe" product-name="Cut Browser" product-version="${version}">
      <authenticode-sign description="Cut Browser" />
    </pe-file>
  </zip-file>
</artifact-configuration>
